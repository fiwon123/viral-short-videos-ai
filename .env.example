# Copy this file to .env once per machine. .env is ignored by git.
# Leave a value empty to discover workspace/<slug>/ or the legacy channels/ and episodes/.
# A command-line value always wins:
# make render CHANNEL=workspace/<slug>/channel/channel.json EPISODE=workspace/<slug>/episodes/<episode>/episode.json

# Channel manifest used for voices, palette, scene library, and Foley.
CHANNEL=

# Episode source used by validate, check, audio, preview, and render.
EPISODE=

# Renderer for browser-backed shots: hyperframes, remotion, or python.
RENDERER=hyperframes

# Python with the studio requirements installed.
PYTHON=audio-models/venv/bin/python
