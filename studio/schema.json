{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:viral-short-videos:studio",
  "title": "Viral Short Videos Studio",
  "description": "Manifest definitions for channels, episodes, libraries and reusable recipes.",
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "tags": {"type": "array", "items": {"$ref": "#/$defs/text"}, "minItems": 1, "uniqueItems": true},
    "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
    "paint": {
      "description": "A hex colour or a named palette role.",
      "anyOf": [
        {"$ref": "#/$defs/color"},
        {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
      ]
    },
    "ease": {
      "description": "A named easing, a cubic-bezier curve, or a spring.",
      "anyOf": [
        {"enum": ["linear", "in", "out", "smooth", "sine", "expo", "circ", "quint", "back", "elastic", "bounce", "spring", "hold", "auto"]},
        {
          "type": "object", "required": ["type"], "additionalProperties": false,
          "properties": {
            "type": {"enum": ["cubic-bezier", "spring"]},
            "points": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": -2, "maximum": 3}},
            "stiffness": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
            "damping": {"type": "number", "minimum": 0, "maximum": 200},
            "mass": {"type": "number", "exclusiveMinimum": 0, "maximum": 100}
          },
          "if": {"properties": {"type": {"const": "cubic-bezier"}}},
          "then": {"required": ["points"]}
        }
      ]
    },
    "gradient": {
      "type": "object", "required": ["stops"], "additionalProperties": false,
      "properties": {
        "type": {"enum": ["linear", "radial"], "default": "linear"},
        "angle": {"type": "number", "minimum": -360, "maximum": 360, "default": 90},
        "center": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/unit"}},
        "radius": {"type": "number", "exclusiveMinimum": 0, "maximum": 2},
        "stops": {
          "type": "array", "minItems": 2, "maxItems": 16,
          "items": {
            "type": "object", "required": ["at", "color"], "additionalProperties": false,
            "properties": {"at": {"$ref": "#/$defs/unit"}, "color": {"$ref": "#/$defs/paint"}}
          }
        }
      }
    },
    "stroke": {
      "type": "object", "required": ["width"], "additionalProperties": false,
      "properties": {
        "width": {"$ref": "#/$defs/unit"},
        "color": {"$ref": "#/$defs/paint"}
      }
    },
    "shadow": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "color": {"$ref": "#/$defs/paint"},
        "offset_x": {"type": "number", "minimum": -0.5, "maximum": 0.5},
        "offset_y": {"type": "number", "minimum": -0.5, "maximum": 0.5},
        "blur": {"$ref": "#/$defs/unit"},
        "opacity": {"$ref": "#/$defs/unit"}
      }
    },
    "glow": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "color": {"$ref": "#/$defs/paint"},
        "size": {"$ref": "#/$defs/unit"},
        "opacity": {"$ref": "#/$defs/unit"}
      }
    },
    "trail": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "count": {"type": "integer", "minimum": 1, "maximum": 8},
        "spacing": {"type": "number", "minimum": 0, "maximum": 0.5},
        "opacity": {"$ref": "#/$defs/unit"},
        "scale_falloff": {"$ref": "#/$defs/unit"},
        "blend": {"enum": ["normal", "add", "screen", "multiply", "overlay", "soft-light"]}
      }
    },
    "unit": {"type": "number", "minimum": 0, "maximum": 1},
    "seconds": {"type": "number", "minimum": 0, "maximum": 720},
    "path": {"type": "string", "minLength": 1},
    "camera_key": {
      "type": "object", "required": ["at"], "additionalProperties": false,
      "properties": {
        "at": {"$ref": "#/$defs/unit"},
        "ease": {"$ref": "#/$defs/ease"},
        "x": {"type": "number", "minimum": -1, "maximum": 1},
        "y": {"type": "number", "minimum": -1, "maximum": 1},
        "zoom": {"type": "number", "exclusiveMinimum": 0, "maximum": 4},
        "rotate": {"type": "number", "minimum": -180, "maximum": 180},
        "fov": {"type": "number", "minimum": 10, "maximum": 110}
      }
    },
    "camera": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "x": {"type": "number", "minimum": -1, "maximum": 1},
        "y": {"type": "number", "minimum": -1, "maximum": 1},
        "zoom": {"type": "number", "exclusiveMinimum": 0, "maximum": 4},
        "rotate": {"type": "number", "minimum": -180, "maximum": 180},
        "preset": {"enum": ["push-in", "pull-out", "crash-zoom", "whip-pan", "dolly", "float", "orbit", "handheld"]},
        "samples": {"type": "integer", "minimum": 2, "maximum": 240},
        "shake": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "amplitude": {"type": "number", "minimum": 0, "maximum": 0.2},
            "frequency": {"type": "number", "minimum": 0.1, "maximum": 60},
            "decay": {"type": "number", "minimum": 0, "maximum": 1},
            "seed": {"type": "number"}
          }
        },
        "handheld": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "amplitude": {"type": "number", "minimum": 0, "maximum": 0.05},
            "frequency": {"type": "number", "minimum": 0.1, "maximum": 12},
            "seed": {"type": "number"}
          }
        },
        "track": {
          "type": "object", "required": ["layer"], "additionalProperties": false,
          "properties": {
            "layer": {"$ref": "#/$defs/text"},
            "x": {"type": "number", "minimum": -1, "maximum": 2},
            "y": {"type": "number", "minimum": -1, "maximum": 2}
          }
        },
        "shakes": {
          "type": "array",
          "items": {
            "type": "object", "required": ["at"], "additionalProperties": false,
            "properties": {
              "at": {"$ref": "#/$defs/unit"},
              "duration": {"type": "number", "exclusiveMinimum": 0, "maximum": 5},
              "amplitude": {"type": "number", "minimum": 0, "maximum": 0.2},
              "frequency": {"type": "number", "minimum": 0.1, "maximum": 60},
              "decay": {"type": "number", "minimum": 0, "maximum": 1},
              "seed": {"type": "number"}
            }
          }
        },
        "keyframes": {"type": "array", "items": {"$ref": "#/$defs/camera_key"}}
      }
    },
    "post": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "grain": {"$ref": "#/$defs/unit"},
        "vignette": {"$ref": "#/$defs/unit"},
        "bloom": {"$ref": "#/$defs/unit"},
        "blur": {"$ref": "#/$defs/unit"},
        "chromatic": {"$ref": "#/$defs/unit"},
        "letterbox": {"$ref": "#/$defs/unit"},
        "brightness": {"type": "number", "minimum": 0, "maximum": 2},
        "contrast": {"type": "number", "minimum": 0, "maximum": 2},
        "saturation": {"type": "number", "minimum": 0, "maximum": 2},
        "hue": {"type": "number", "minimum": -180, "maximum": 180},
        "tint": {"$ref": "#/$defs/paint"}
      }
    },
    "style": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "preset": {"$ref": "#/$defs/text"},
        "energy": {"$ref": "#/$defs/unit"}
      }
    },
    "music": {
      "type": "object", "additionalProperties": false,
      "oneOf": [{"required": ["preset"]}, {"required": ["file"]}],
      "properties": {
        "preset": {"const": "pulse"},
        "file": {"$ref": "#/$defs/path"},
        "gain": {"$ref": "#/$defs/unit"},
        "loop": {"type": "boolean"},
        "fade_in": {"type": "number", "minimum": 0, "maximum": 30},
        "fade_out": {"type": "number", "minimum": 0, "maximum": 30},
        "duck": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "amount": {"$ref": "#/$defs/unit"},
            "attack": {"type": "number", "minimum": 0, "maximum": 2},
            "release": {"type": "number", "minimum": 0, "maximum": 3}
          }
        }
      }
    },
    "style_preset": {
      "type": "object", "required": ["name"], "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/text"},
        "description": {"$ref": "#/$defs/text"},
        "camera": {"$ref": "#/$defs/camera"},
        "motion_blur": {"$ref": "#/$defs/unit"},
        "supersample": {"type": "integer", "minimum": 1, "maximum": 2},
        "post": {"$ref": "#/$defs/post"},
        "captions": {"$ref": "#/$defs/captions"},
        "audio": {"$ref": "#/$defs/audio"},
        "render": {"$ref": "#/$defs/render"},
        "music": {"$ref": "#/$defs/music"}
      }
    },
    "captions": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "style": {"enum": ["box", "karaoke", "minimal"]},
        "position": {"enum": ["top", "center", "bottom"]},
        "highlight": {"$ref": "#/$defs/paint"},
        "highlight_text": {"$ref": "#/$defs/paint"},
        "foreground": {"$ref": "#/$defs/paint"},
        "background": {"$ref": "#/$defs/paint"},
        "uppercase": {"type": "boolean"},
        "max_words": {"type": "integer", "minimum": 1, "maximum": 12},
        "max_lines": {"type": "integer", "minimum": 1, "maximum": 8},
        "font": {"$ref": "#/$defs/text"},
        "font_size": {"type": "number", "minimum": 0.5, "maximum": 2},
        "stroke": {"$ref": "#/$defs/unit"},
        "shadow": {"type": "boolean"},
        "shadow_color": {"$ref": "#/$defs/paint"},
        "radius": {"$ref": "#/$defs/unit"},
        "offset": {"type": "number", "minimum": -0.5, "maximum": 0.5},
        "align": {"enum": ["left", "center", "right"]},
        "line_height": {"type": "number", "minimum": 0.8, "maximum": 2.5},
        "letter_spacing": {"type": "number", "minimum": -0.2, "maximum": 0.5},
        "padding_x": {"type": "number", "minimum": 0, "maximum": 0.25},
        "padding_y": {"type": "number", "minimum": 0, "maximum": 0.25},
        "background_opacity": {"$ref": "#/$defs/unit"},
        "animation": {"enum": ["none", "pop", "slide", "fade", "rise"]}
      }
    },
    "master_audio": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "gain": {"type": "number", "minimum": 0, "maximum": 2},
        "loudness": {"type": "number", "minimum": -40, "maximum": 0},
        "true_peak": {"type": "number", "minimum": -9, "maximum": 0},
        "compress": {"type": "boolean"},
        "stereo_width": {"type": "number", "minimum": 0, "maximum": 2}
      }
    },
    "reverb": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "mix": {"$ref": "#/$defs/unit"},
        "size": {"$ref": "#/$defs/unit"}
      }
    },
    "render": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "crf": {"type": "integer", "minimum": 0, "maximum": 51},
        "preset": {"enum": ["ultrafast", "superfast", "veryfast", "faster", "fast", "medium", "slow", "slower", "veryslow", "placebo"]},
        "tune": {"enum": ["animation", "film", "grain", "stillimage", "fastdecode", "zerolatency", "none"]},
        "audio_bitrate": {"type": "integer", "minimum": 64, "maximum": 512},
        "captions": {"type": "boolean"},
        "thumbnail": {"type": "boolean"},
        "publishing": {"type": "boolean"},
        "stems": {"type": "boolean"},
        "supersample": {"type": "integer", "minimum": 1, "maximum": 2},
        "motion_blur": {"$ref": "#/$defs/unit"},
        "master": {"type": "boolean"},
        "scale": {"type": "number", "exclusiveMinimum": 0, "maximum": 2},
        "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647}
      }
    },
    "audio": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "master": {"$ref": "#/$defs/master_audio"},
        "reverb": {"$ref": "#/$defs/reverb"},
        "room_tone": {
          "type": "object", "additionalProperties": false,
          "oneOf": [{"required": ["sound"]}, {"required": ["file"]}],
          "properties": {
            "sound": {"$ref": "#/$defs/text"},
            "file": {"$ref": "#/$defs/path"},
            "gain": {"$ref": "#/$defs/unit"}
          }
        }
      }
    },
    "channel": {
      "type": "object",
      "required": ["name", "tagline", "description", "tags", "mark", "palette"],
      "additionalProperties": false,
      "properties": {
        "$schema": {"type": "string"},
        "meta": {"type": "object", "additionalProperties": true},
        "name": {"$ref": "#/$defs/text"},
        "handle": {"$ref": "#/$defs/text"},
        "tagline": {"$ref": "#/$defs/text"},
        "description": {"$ref": "#/$defs/text"},
        "tags": {"$ref": "#/$defs/tags"},
        "mark": {"type": "string", "minLength": 1, "maxLength": 6},
        "palette": {
          "type": "object", "required": ["background", "foreground", "accent", "secondary"],
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
          "additionalProperties": {"$ref": "#/$defs/color"}
        },
        "font": {"$ref": "#/$defs/path"},
        "fonts": {
          "description": "Named font roles resolved by text and caption layers.",
          "type": "object",
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
          "additionalProperties": {"$ref": "#/$defs/path"}
        },
        "brand": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "logo": {"enum": ["disc", "ring", "rounded", "square"]},
            "banner": {"enum": ["lines", "dots", "grid", "none"]},
            "mark_size": {"$ref": "#/$defs/unit"},
            "outline": {"$ref": "#/$defs/unit"},
            "accent_dot": {"type": "boolean"}
          }
        },
        "scene_library": {"$ref": "#/$defs/path"},
        "audio_library": {"$ref": "#/$defs/path"},
        "captions": {"$ref": "#/$defs/captions"},
        "style": {"$ref": "#/$defs/style"},
        "audio": {"$ref": "#/$defs/audio"},
        "render": {"$ref": "#/$defs/render"},
        "post": {"$ref": "#/$defs/post"},
        "motion_blur": {"$ref": "#/$defs/unit"},
        "banner": {
          "type": "object", "required": ["width", "height", "safe_width", "safe_height"], "additionalProperties": false,
          "properties": {
            "width": {"type": "integer", "minimum": 320, "maximum": 4096},
            "height": {"type": "integer", "minimum": 160, "maximum": 4096},
            "safe_width": {"type": "integer", "minimum": 160},
            "safe_height": {"type": "integer", "minimum": 80}
          }
        }
      }
    },
    "pose": {
      "type": "object",
      "properties": {
        "x": {"type": "number", "minimum": -2, "maximum": 3},
        "y": {"type": "number", "minimum": -2, "maximum": 3},
        "scale": {"type": "number", "exclusiveMinimum": 0, "maximum": 4},
        "scale_x": {"type": "number", "exclusiveMinimum": 0, "maximum": 4},
        "scale_y": {"type": "number", "exclusiveMinimum": 0, "maximum": 4},
        "skew_x": {"type": "number", "minimum": -89, "maximum": 89},
        "skew_y": {"type": "number", "minimum": -89, "maximum": 89},
        "rotate": {"type": "number", "minimum": -3600, "maximum": 3600},
        "opacity": {"$ref": "#/$defs/unit"},
        "visible": {"type": "boolean"}
      }
    },
    "keyframe": {
      "type": "object", "required": ["at"],
      "allOf": [{"$ref": "#/$defs/pose"}],
      "unevaluatedProperties": false,
      "properties": {
        "at": {"$ref": "#/$defs/unit"},
        "ease": {"$ref": "#/$defs/ease"},
        "ease_props": {
          "description": "Per-property easing overrides for this keyframe.",
          "type": "object",
          "propertyNames": {"enum": ["x", "y", "scale", "scale_x", "scale_y", "skew_x", "skew_y", "rotate", "opacity"]},
          "additionalProperties": {"$ref": "#/$defs/ease"}
        }
      }
    },
    "mask": {
      "type": "object", "required": ["source"], "additionalProperties": false,
      "properties": {
        "source": {"$ref": "#/$defs/text"},
        "scope": {"enum": ["episode", "channel"]},
        "mode": {"enum": ["alpha", "luma"]},
        "invert": {"type": "boolean"},
        "feather": {"$ref": "#/$defs/unit"}
      }
    },
    "layer": {
      "type": "object", "required": ["id", "kind", "x", "y"],
      "allOf": [
        {"$ref": "#/$defs/pose"},
        {"if": {"required": ["asset_scope"]}, "then": {"properties": {"kind": {"enum": ["svg", "particles"]}}}}
      ],
      "unevaluatedProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "kind": {"enum": ["rect", "ellipse", "polygon", "text", "image", "svg", "group", "particles", "use"]},
        "ref": {"$ref": "#/$defs/text"},
        "plane": {"enum": ["background", "foreground"]},
        "asset_scope": {"enum": ["episode", "channel"]},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 2},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 2},
        "fill": {
          "description": "Solid paint or a linear/radial gradient.",
          "anyOf": [{"$ref": "#/$defs/paint"}, {"$ref": "#/$defs/gradient"}]
        },
        "stroke": {"$ref": "#/$defs/stroke"},
        "shadow": {"$ref": "#/$defs/shadow"},
        "glow": {"$ref": "#/$defs/glow"},
        "trail": {"$ref": "#/$defs/trail"},
        "font": {"$ref": "#/$defs/text"},
        "align": {"enum": ["left", "center", "right"]},
        "line_height": {"type": "number", "minimum": 0.5, "maximum": 3},
        "letter_spacing": {"type": "number", "minimum": -0.2, "maximum": 0.5},
        "max_lines": {"type": "integer", "minimum": 1, "maximum": 20},
        "uppercase": {"type": "boolean"},
        "radius": {"$ref": "#/$defs/unit"},
        "text": {"$ref": "#/$defs/text"},
        "file": {"$ref": "#/$defs/path"},
        "mouth_for": {"$ref": "#/$defs/text"},
        "parent": {"$ref": "#/$defs/text"},
        "variant_group": {"$ref": "#/$defs/text"},
        "pivot": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"$ref": "#/$defs/unit"}
        },
        "blend": {"enum": ["normal", "add", "screen", "multiply", "overlay", "soft-light"]},
        "blur": {"$ref": "#/$defs/unit"},
        "parallax": {"type": "number", "minimum": 0, "maximum": 2},
        "mask": {"$ref": "#/$defs/mask"},
        "viseme_for": {"$ref": "#/$defs/text"},
        "viseme": {"$ref": "#/$defs/text"},
        "count": {"type": "integer", "minimum": 1, "maximum": 300},
        "rate": {"type": "number", "minimum": 0, "maximum": 300},
        "life": {"type": "number", "exclusiveMinimum": 0, "maximum": 30},
        "velocity": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"type": "number", "minimum": 0, "maximum": 20}
        },
        "spread": {"type": "number", "minimum": 0, "maximum": 1},
        "gravity": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"type": "number", "minimum": -20, "maximum": 20}
        },
        "size": {
          "type": "array", "minItems": 1, "maxItems": 2,
          "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 2}
        },
        "seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "area": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"type": "number", "minimum": 0, "maximum": 2}
        },
        "hitbox": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 2}
        },
        "points": {
          "type": "array", "minItems": 3,
          "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/unit"}}
        },
        "keyframes": {"type": "array", "items": {"$ref": "#/$defs/keyframe"}}
      },
      "if": {"properties": {"kind": {"enum": ["image", "svg", "particles"]}}},
      "then": {"required": ["file"]},
      "else": {
        "allOf": [
          {"if": {"properties": {"kind": {"const": "text"}}}, "then": {"required": ["text"]}},
          {"if": {"properties": {"kind": {"const": "polygon"}}}, "then": {"required": ["points"]}},
          {"if": {"properties": {"kind": {"const": "use"}}}, "then": {"required": ["ref"]}}
        ]
      }
    },
    "cast_voice": {
      "type": "object", "required": ["engine", "direction"], "additionalProperties": false,
      "properties": {
        "engine": {"enum": ["kokoro", "recorded"]},
        "direction": {"$ref": "#/$defs/text"},
        "identity": {"$ref": "#/$defs/text"},
        "character_design": {
          "type": "object", "required": ["reference", "traits", "voice_fit"], "additionalProperties": false,
          "properties": {
            "reference": {"$ref": "#/$defs/path"},
            "traits": {"$ref": "#/$defs/text"},
            "voice_fit": {"$ref": "#/$defs/text"},
            "approved_take": {"$ref": "#/$defs/path"}
          }
        },
        "blend": {
          "type": "object", "minProperties": 1, "maxProperties": 4,
          "propertyNames": {"pattern": "^[a-z]{2}_[a-z0-9_]+$"},
          "additionalProperties": {"type": "number", "exclusiveMinimum": 0, "maximum": 100}
        },
        "language": {"enum": ["en-us", "en-gb", "es", "fr-fr", "hi", "it", "pt-br", "ja", "zh"]},
        "speed": {"type": "number", "minimum": 0.5, "maximum": 2}
      },
      "if": {"properties": {"engine": {"const": "kokoro"}}},
      "then": {"required": ["blend", "language"]},
      "else": {"required": ["identity"], "not": {"anyOf": [
        {"required": ["blend"]}, {"required": ["language"]}, {"required": ["speed"]}
      ]}}
    },
    "audio_library": {
      "type": "object", "required": ["version"], "additionalProperties": false,
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "voices": {
          "type": "object", "propertyNames": {"$ref": "#/$defs/text"},
          "additionalProperties": {"$ref": "#/$defs/cast_voice"}
        },
        "sounds": {
          "type": "object", "propertyNames": {"$ref": "#/$defs/text"},
          "additionalProperties": {
            "type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}
          }
        }
      }
    },
    "word": {
      "type": "object", "required": ["text", "start", "end"], "additionalProperties": false,
      "properties": {
        "text": {"$ref": "#/$defs/text"},
        "start": {"type": "number", "minimum": 0, "maximum": 720},
        "end": {"type": "number", "minimum": 0, "maximum": 720}
      }
    },
    "viseme": {
      "type": "object", "required": ["at", "shape"], "additionalProperties": false,
      "properties": {
        "at": {"type": "number", "minimum": 0, "maximum": 720},
        "shape": {"$ref": "#/$defs/text"}
      }
    },
    "speech": {
      "type": "object", "required": ["speaker", "text"], "additionalProperties": false,
      "properties": {
        "speaker": {"$ref": "#/$defs/text"},
