{
  "id": "{{id}}",
  "duration": "{{duration}}",
  "direction": "Reaction shot: hold the face, then let the eyes snap to the prop.",
  "layers": [
    {"id": "bg", "kind": "rect", "x": 0.5, "y": 0.5, "width": 1.2, "height": 1.2, "fill": "background", "plane": "background"},
    {"id": "body", "kind": "rect", "x": 0.5, "y": 0.66, "width": 0.28, "height": 0.24, "fill": "secondary", "radius": 0.45, "pivot": [0.5, 0.5]},
    {"id": "head", "kind": "ellipse", "x": 0, "y": -0.2, "width": 0.2, "height": 0.2, "fill": "foreground", "parent": "body", "pivot": [0.5, 0.8]},
    {"id": "eye-open", "kind": "ellipse", "x": 0.025, "y": -0.24, "width": 0.018, "height": 0.018, "fill": "background", "parent": "head", "variant_group": "eyes"},
    {"id": "eye-blink", "kind": "rect", "x": 0.025, "y": -0.24, "width": 0.022, "height": 0.004, "fill": "background", "parent": "head", "variant_group": "eyes", "visible": false,
     "keyframes": [{"at": 0.62, "visible": true}, {"at": 0.74, "visible": false}]},
    {"id": "prop", "kind": "rect", "x": "{{prop_x}}", "y": "{{prop_y}}", "width": 0.12, "height": 0.08, "fill": "accent", "radius": 0.2}
  ],
  "sfx": [{"at": 0.1, "cue": "pop", "gain": 0.18}]
}
